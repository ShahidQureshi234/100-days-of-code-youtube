# ============================================================
# SmartConvertAI -- environment configuration
# Copy to .env.local (Next.js) and adjust for your machine.
# ============================================================

# --- Database (Prisma) ---------------------------------------
# SQLite (default, zero-config). The file lands next to prisma/schema.prisma.
DATABASE_URL="file:./dev.db"
# PostgreSQL example:
# DATABASE_URL="postgresql://user:password@localhost:5432/smartconvert?schema=public"

# --- Python engine --------------------------------------------
# Interpreter used to spawn python-engine/process_scan.py.
# Resolution order when unset: python-engine/.venv/bin/python3 -> python3
PYTHON_BIN=""
# e.g. PYTHON_BIN="/usr/bin/python3" or "python-engine/.venv/bin/python3"

# Hard timeout for one engine invocation (detect/process/export), ms.
ENGINE_TIMEOUT_MS=120000

# --- Uploads ---------------------------------------------------
# Maximum upload size per image, in megabytes.
MAX_UPLOAD_MB=25

# --- Runtime workspace ------------------------------------------
# Where uploads, processed artifacts and export PDFs live.
# Defaults to <os tmpdir>/smartconvert-ai when unset.
DATA_DIR=""

# --- App --------------------------------------------------------
# Shown in the header / PDF metadata producer string.
APP_NAME="SmartConvertAI"
NODE_ENV=development
